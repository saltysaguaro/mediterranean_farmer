{
  "schema_version": "1.0",
  "title": "Sicily Thermal Comfort × Drought",
  "scope": "scope.json",
  "variable_schema": "manifest.schema.json",
  "variables": [
    "variables/utci_daymax_median.json",
    "variables/spei_3.json"
  ],
  "default_view": {
    "x_variable": "spei_3",
    "y_variable": "utci_daymax_median",
    "month_mask": "fff",
    "year_policy": "latest_complete"
  },
  "maximum_active_variables": 2,
  "service": {
    "api_version": "v1",
    "dataset_version": "sicily-2024-2025-v1",
    "api_base": "/api",
    "palette_version": "sicily-bivariate-v1",
    "maximum_zoom": 9,
    "maximum_product_files": 8,
    "maximum_cells_per_product": 512,
    "release_report": "pipeline/reports/sicily-release-v1.json",
    "runtime": {
      "request_timeout_seconds": 5,
      "maximum_response_bytes": 204800,
      "maximum_concurrency": 8,
      "requests_per_minute": 120,
      "cache_directory": "data/cache/responses",
      "maximum_cache_entries": 512,
      "cache_maximum_bytes": 268435456,
      "allowed_origins": [
        "same-origin"
      ]
    }
  }
}
