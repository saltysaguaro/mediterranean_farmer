{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sicily-thermal-drought/variable-manifest.schema.json",
  "title": "Sicily Thermal Comfort × Drought variable manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "label",
    "description",
    "unit",
    "source",
    "coverage",
    "aggregation",
    "classification",
    "grid_id",
    "quality",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "short_label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "role_hint": {
      "type": "string",
      "enum": ["x", "y", "either"]
    },
    "grid_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "provider",
        "dataset_url",
        "doi",
        "product_version",
        "reference_period",
        "license",
        "license_url"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dataset_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\."
        },
        "product_version": {
          "type": "string",
          "minLength": 1
        },
        "reference_period": {
          "type": ["string", "null"]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "resolution_degrees",
        "calendar",
        "provider_start_year",
        "provider_end_policy",
        "months"
      ],
      "properties": {
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "resolution_degrees": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "calendar": {
          "type": "string",
          "enum": ["gregorian", "proleptic_gregorian"]
        },
        "provider_start_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2200
        },
        "provider_end_policy": {
          "type": "string",
          "enum": ["near_real_time", "fixed"]
        },
        "months": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_frequency",
        "source_statistic",
        "temporal_note",
        "allowed",
        "default",
        "minimum_valid_fraction",
        "month_weighting"
      ],
      "properties": {
        "input_frequency": {
          "type": "string",
          "enum": ["daily", "monthly"]
        },
        "source_statistic": {
          "type": "string",
          "minLength": 1
        },
        "temporal_note": {
          "type": "string",
          "minLength": 20
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["median"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {
          "const": "median"
        },
        "minimum_valid_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "month_weighting": {
          "const": "equal"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "breaks",
        "break_assignments",
        "labels",
        "raw_value_order",
        "axis_display_order",
        "version"
      ],
      "properties": {
        "type": {
          "const": "fixed"
        },
        "breaks": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "break_assignments": {
          "description": "For each exact break value, select the class below or above that break in ascending raw-value order.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["lower_class", "upper_class"]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "raw_value_order": {
          "const": "ascending"
        },
        "axis_display_order": {
          "type": "string",
          "enum": ["ascending", "descending"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "mask", "field", "pass_values"],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["none", "mask", "flag"]
        },
        "mask": {
          "type": ["string", "null"]
        },
        "field": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "pass_values": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "data_version", "published_years", "sample_retrieved_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["planned", "sample", "published"]
        },
        "data_version": {
          "type": "string",
          "minLength": 1
        },
        "published_years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          },
          "uniqueItems": true
        },
        "sample_retrieved_at": {
          "description": "UTC source-retrieval completion timestamp for this bounded publication; null until acquired.",
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
